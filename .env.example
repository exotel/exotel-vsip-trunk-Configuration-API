# Exotel SIP Trunking API Configuration
# Copy this file to .env and fill in your values

# Authentication
EXO_AUTH_KEY=your_api_key
EXO_AUTH_TOKEN=your_api_token

# Account
EXO_ACCOUNT_SID=your_account_sid
EXO_SUBSCRIBIX_DOMAIN=api.in.exotel.com

# Trunk (set after creating trunk)
TRUNK_SID=your_trunk_sid

# Phone Number Mapping
DID_NUMBER=+919876543210
MODE=pstn

# For Update Phone Number
PHONE_NUMBER_ID=your_phone_number_id
PHONE_NUMBER=+919876543210

# IP Whitelist
WHITELIST_IP=your_server_ip
WHITELIST_MASK=32

# Destination URI (for inbound)
TRUNK_DEST_IP=your_server_ip
TRUNK_DEST_PORT=5061
TRANSPORT=tls

# Virtual number for trunk alias (E.164 format)
# Choose from your virtual numbers: https://my.in.exotel.com/numbers
EXOPHONE=+919876543210

# SIP digest credentials (Voice AI / Streamkit — optional for tests)
SIP_CRED_USERNAME=voice_ai_user
SIP_CRED_PASSWORD=
SIP_CRED_FRIENDLY_NAME=streamkit
CREDENTIAL_ID=

# Pagination for list APIs (optional)
PAGE_SIZE=50
PAGE_OFFSET=0

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 1. Get API credentials: https://my.in.exotel.com/apisettings/site#api-credentials
# 2. Find your virtual numbers: https://my.in.exotel.com/numbers
# 3. Create call flows (if needed): https://my.in.exotel.com/apps#installed-apps
# 4. Copy this file to .env and fill in your actual values
# 5. Run: python3 tests/test_all_apis.py to test your setup

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. NEVER commit the .env file to git
# 2. Keep your API credentials secure
# 3. Use different credentials for testing vs production
# 4. Regularly rotate your API keys
# 5. Monitor API usage in Exotel dashboard
